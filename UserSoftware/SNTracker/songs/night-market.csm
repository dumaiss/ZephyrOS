    instrument echoey {
        priority = required;
        level    = 255;
        gate     = 6;
        envelope = table([238, 221, 68, 51, 170, 153, 51, 34, 102, 85, 34, 17, 51, 34, 17, 17, 0], 2, -1, -1);
    }
    instrument leadmelody {
        priority = required;
        level    = 255;
        gate     = 6;
        // [ADSR] raw: 0 15 221 0 2 0 0 0 28   (approximated)
        envelope = adsr(17, 1920, 0, 137);
        effects  = [vibrato(106, 32)];
    }

    }
    realize Nperchat {
        waveform = noise;
        mode     = white;   // inferred from the duty macro
        rate     = high;   // inferred from the fixed arp macro

        extension sn76489 {
            phase_reset = 1;
        }
    }
    realize Nweirdsoft {
        waveform = noise;

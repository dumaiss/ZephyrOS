    orchestra Chip {
        layer ch0.main {
            source     = ch0;
            instrument = echoey;
            route      = C;
        }
        layer ch1.main {
            source     = ch1;
            instrument = echoey;
            route      = C;
        }
        layer ch2.main {
            source     = ch2;
            instrument = echoey;
            route      = C;
        }
        layer perc.main {
            source     = perc;
            instrument = Nweirdsoft;
            route      = C;
        }
    }

    scene all {
        enables = [ch0.main, ch1.main, ch2.main, perc.main];
    }

    form main {
        using    = Chip;
        sequence = [
            play(ord00, all),
            play(ord01, all),
            play(ord02, all),
            play(ord03, all),
            play(ord04, all),
            play(ord05, all),
            play(ord06, all),
            play(ord07, all),
            play(ord08, all),
            play(ord09, all),
            play(ord0a, all),
            play(ord0b, all),
            play(ord0c, all),
            play(ord0d, all),
            play(ord0e, all),
            play(ord0f, all),
            play(ord10, all),
            play(ord11, all),
            play(ord12, all),
            play(ord13, all),
            play(ord14, all),
            play(ord15, all),
            play(ord16, all),
            play(ord17, all),
            play(ord18, all),
            play(ord19, all),
            play(ord1a, all),
            play(ord1b, all),
            play(ord1c, all),
            play(ord1d, all)
        ];
        loop     = 0;
    }
}

target AfternoonBlend {
    backend   = sn76489x4;
    clock     = 3579545;
    transpose = 0;

    routes {
        C = psg0;   // the source uses 3 tone + 1 noise voice
    }

    realize echoey {
        waveform = square;
    }
    realize leadmelody {
        waveform = square;
    }
    realize leadharmony {
        waveform = square;
    }
    realize leadmelmony {
        waveform = square;
    }
    realize phaser1 {
        waveform = square;
    }
    realize phaser2 {
        waveform = square;
    }
    realize accent {
        waveform = square;
    }
    realize wavyfull {
        waveform = square;
    }
    realize wavyhalf {
        waveform = square;
    }
    realize bip {
        waveform = square;
    }
    realize Nperclong {
        waveform = noise;
        mode     = white;   // inferred from the duty macro
        rate     = medium;   // inferred from the fixed arp macro

        extension sn76489 {
            phase_reset = 1;
        }
    }
    realize Npercshort {
        waveform = noise;
        mode     = periodic;   // inferred from the duty macro
        rate     = medium;   // inferred from the fixed arp macro

        extension sn76489 {
            phase_reset = 1;

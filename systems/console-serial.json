{
  "schema": "kos-system-1",
  "name": "console-serial",
  "drivers": [
    "sio",
    "ioc",
    "hid",
    "v9958",
    "console-serial",
    "timer",
    "iocfat"
  ],
  "boot": "/system/shell.exe",
  "after_exit": "relaunch",
  "store": [
    "shell.exe",
    "monitor.exe",
    "hwtest.exe",
    "timer.exe",
    "xmem_selftest.exe",
    "xmem_child.exe",
    "xmem_far.exe",
    "fs_selftest.exe",
    "fs_child.exe",
    "far_data.exe",
    "banks.exe",
    "known.bin"
  ],
  "cflags": [
    "-DKOS_DRIVER_TEST_EVIDENCE=1",
    "-DKOS_SMOKE_HOST_SYNC=1"
  ]
}
